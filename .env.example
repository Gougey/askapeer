# Copy to .env for local development. Matches docker-compose.yml.
DATABASE_URL=postgres://askapeer:askapeer@localhost:5432/askapeer
REDIS_URL=redis://localhost:6379
API_PORT=4000
# The web app calls the API at this origin (server-side).
API_ORIGIN=http://localhost:4000

# Where links in emails point (sign-in links, deep links into notices). Every deployed
# environment MUST set this, or members receive links to somebody else's machine.
WEB_ORIGIN=http://localhost:3000

# Outbound mail. `log` (the default) writes what would be sent to the API log and sends
# nothing — right for local dev, and the reason the whole notification path could be built
# before an email account existed. A real environment must set a real provider, or members
# get no sign-in links and a suspended member gets no notice at all.
EMAIL_PROVIDER=log

# Only read when EMAIL_PROVIDER=postmark. The Server API Token is a SECRET — it can send
# mail as us, so it belongs in a Fly secret (`flyctl secrets set POSTMARK_TOKEN=...`) and
# never in fly.toml, because this repo is public.
# POSTMARK_TOKEN=
# The From address. Must be on a domain verified in Postmark — we send from the `mail.`
# subdomain so the root domain's own mail flow is untouched.
EMAIL_FROM=AskaPeer <no-reply@mail.askapeer.co.uk>

# Auth (S1). Use a strong random value in real environments.
JWT_SECRET=dev-insecure-secret-change-me

# Verification (S2). Uses the simulated register lookup + identity check, and exposes
# the stand-in Onfido capture screen. MUST be false/unset in real production — with it
# unset the simulated-callback endpoint 404s.
VERIFICATION_SIMULATE=true

# Admin console (S11a). Comma-separated email allowlist — any member whose account email
# is listed here can reach /admin (read-only members / verification / audit views).
# Empty = no admins. This is the interim gate until the moderator/administrator JWT
# claims land (S11/S13).
ADMIN_EMAILS=
