{
  "name": "askapeer",
  "version": "0.0.0",
  "private": true,
  "description": "Askapeer — verified, pseudonymous professional network for sports medicine practitioners.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "tokens:build": "npm run build -w @askapeer/design-tokens",
    "tokens:check": "npm run check -w @askapeer/design-tokens",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  }
}
